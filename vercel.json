{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.lsfencingandmetalwork.com"
        }
      ],
      "destination": "https://lsfencingandmetalwork.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lsfencingandmetalwork.com"
        }
      ],
      "destination": "https://lsfencingandmetalwork.com/:path*",
      "permanent": true
    }
  ]
}
